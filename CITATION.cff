    family-names: Kelly-Reif
license: Apache-2.0
repository-code: "https://github.com/ChelseaKR/afterward"
url: "https://afterward.chelseakr.com"
version: "0.1.0"
keywords:
  - california
  - workforce
  - wioa
  - training-programs
  - labor-market
  - open-data
  - civic-tech
