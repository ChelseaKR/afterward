{
  "about": "Does the model turn a person's words into the right structured query, and refuse to guess when the words do not support one? Expected values are checked by code: scalar fields by equality, numbers within 1%, occupation terms by what they resolve to in the dataset, regions by the area they resolve to. Vague cases list the fields the model has no basis to fill; it passes only if it leaves them empty and asks a clarifying question.",
  "cases": [
    {
      "id": "en-warehouse-fresno",
      "lang": "en",
      "text": "I'm 40, work in a warehouse in Fresno, want something that pays more and isn't going away.",
      "expected": {
        "language": "en",
        "intent": "find_programs",
        "projection": "not_shrinking",
        "current_resolves_to": [
          "53-7062"
        ],
        "region": "Fresno"
      }
    },
    {
      "id": "en-cna-la-cost",
      "lang": "en",
      "text": "Looking for a CNA program in Los Angeles under $2,000.",
      "expected": {
        "language": "en",
        "intent": "find_programs",
        "resolves_to": [
          "31-1131",
          "31-1120"
        ],
        "region": "Los Angeles",
        "max_cost": 2000
      }
    },
    {
      "id": "en-online-short",
      "lang": "en",
      "text": "Any online medical billing course I can finish in about three months?",
      "expected": {
        "language": "en",
        "format": "online",
        "max_weeks": 13,
        "resolves_to": [
          "43-3021",
          "29-2072"
        ]
      }
    },
    {
      "id": "en-hourly-wage",
      "lang": "en",
      "text": "I need to make at least $30 an hour. What trades are growing in San Diego?",
      "expected": {
        "language": "en",
        "projection": "growing",
        "min_annual_wage": 62400,
        "region": "San Diego"
      }
    },
    {
      "id": "en-reported-only",
      "lang": "en",
      "text": "Show me welding programs that actually report what happened to their students.",
      "expected": {
        "language": "en",
        "requires_reported_outcomes": true,
        "resolves_to": [
          "51-4121"
        ]
      }
    },
    {
      "id": "en-shrinking",
      "lang": "en",
      "text": "Which jobs is California expecting to shrink over the next ten years?",
      "expected": {
        "language": "en",
        "projection": "shrinking"
      }
    },
    {
      "id": "en-region-uncovered",
      "lang": "en",
      "text": "Electrician apprenticeships near Lake Tahoe?",
      "expected": {
        "language": "en",
        "resolves_to": [
          "47-2111"
        ],
        "region_unresolved": true
      }
    },
    {
      "id": "en-out-of-scope",
      "lang": "en",
      "text": "I'm undocumented. Can I get a truck driving program paid for and will they sponsor a visa?",
      "expected": {
        "language": "en",
        "resolves_to": [
          "53-3032"
        ],
        "out_of_scope": true
      }
    },
    {
      "id": "en-pathways",
      "lang": "en",
      "text": "I've been a cashier for ten years. What could I move into that's related and growing?",
      "expected": {
        "language": "en",
        "intent": "pathways",
        "projection": "growing",
        "current_resolves_to": [
          "41-2011"
        ]
      }
    },
    {
      "id": "en-coverage-question",
      "lang": "en",
      "text": "Why does it say 'not reported' for employment on so many of these?",
      "expected": {
        "language": "en",
        "intent": "coverage_question"
      }
    },
