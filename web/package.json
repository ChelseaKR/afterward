{
  "name": "camino-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static front end for Camino: California training programs and their outcomes.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "a11y": "node scripts/a11y-audit.mjs out",
    "verify": "npm run typecheck && npm run test && npm run build && npm run a11y"
  },
  "dependencies": {
    "@cagovweb/design-system": "^0.2.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
